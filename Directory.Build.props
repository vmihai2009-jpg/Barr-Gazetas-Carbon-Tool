<Project>
  <!--
    Build once per Revit release:
      dotnet build -c Release -p:RevitVersion=2025
      dotnet build -c Release -p:RevitVersion=2026
      dotnet build -c Release -p:RevitVersion=2027
    Revit 2025 and 2026 run on .NET 8. Revit 2027 runs on .NET 10.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &lt; 2027">net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>3.0.0</Version>
    <Company>Barr Gazetas</Company>
    <Product>Barr Gazetas Carbon Tool</Product>
    <Copyright>See LICENSE and NOTICE.md</Copyright>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\R$(RevitVersion)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\R$(RevitVersion)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" />
  </ItemGroup>
</Project>
